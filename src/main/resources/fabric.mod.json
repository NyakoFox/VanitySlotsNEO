{
	"schemaVersion": 1,
	"id": "vanityslots",
	"version": "${version}",
	"name": "VanitySlots",
	"description": "This mod adds four extra armor slots!\\nThe armor you place in these slots doesn't improve your stats, but they display over your normal armor.",
	"authors": [
		"NyakoFox"
	],
	"contact": {
		"homepage": "https://nyako.dev/",
		"sources": "https://github.com/NyakoFox/VanitySlotsNEO"
	},
	"license": "LGPL-3.0",
	"icon": "assets/vanityslots/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"gay.nyako.vanityslots.VanitySlots"
		],
		"fabric-datagen": [
			"gay.nyako.vanityslots.VanitySlotsDataGenerator"
		]
	},
	"mixins": [
		"vanityslots.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_depends}",
		"fabric-api": "*",
		"configuration": "*"
	}
}